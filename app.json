{
  "expo": {
    "name": "Harf",
    "description": "A complete Urdu course, not a phrasebook. All 40 letters in each of their four joining forms, 2,281 words spoken aloud, 25 grammar patterns in plain English, and 256 sentences you build yourself, across 608 lessons. Readings and conversations throughout, and spaced repetition that schedules every word for the moment revision does the most good.",
    "slug": "harf",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "harf",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#211712"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.harf.urdu"
    },
    "android": {
      "package": "com.harf.urdu",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#3C292C"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#211712",
          "image": "./assets/images/splash.png",
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "storeName": "Harf: Learn Urdu"
    }
  }
}
