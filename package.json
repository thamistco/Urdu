{
  "name": "harf",
  "version": "1.0.0",
  "description": "Harf — learn to read and speak Urdu, script first.",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "gen:sounds": "node scripts/generate-sounds.js",
    "gen:voice": "node scripts/generate-voice.js",
    "check:roman": "node scripts/check-roman.js",
    "check:writing": "node scripts/check-writing.js",
    "check:translit": "node scripts/check-translit.js",
    "gen:masks": "node scripts/generate-glyph-masks.js",
    "audit": "node scripts/audit-content.js",
    "check:trace": "node scripts/check-trace.js",
    "check:voice": "node scripts/check-voice.js",
    "check:voice-fidelity": "node scripts/check-voice-fidelity.js",
    "check:srs": "node scripts/check-srs.js",
    "web:meta": "node scripts/inject-web-meta.js",
    "check:answerable": "node scripts/check-answerable.js",
    "check:stability": "node scripts/check-stability.js",
    "check:theme": "node scripts/check-theme.js",
    "check:direction": "node scripts/check-direction.js",
    "check:scenery": "node scripts/check-scenery.js",
    "check:sizes": "node scripts/check-sizes.js",
    "check:path": "node scripts/check-path.js",
    "check:home-scroll": "node scripts/check-home-scroll.js",
    "check:stage-advance-scroll": "node scripts/check-stage-advance-scroll.js",
    "check:soak-track": "node scripts/check-soak-track.js",
    "check:soak-track-arg": "node scripts/check-soak-track-arg.js",
    "check:all-lock": "node scripts/check-all-lock.js",
    "check:clean-tree": "node scripts/check-clean-tree.js",
    "check:all": "node scripts/check-all.js",
    "soak": "node scripts/soak.js",
    "build:web": "expo export --platform web --output-dir dist",
    "check:deployed": "node scripts/check-deployed.js",
    "lint": "eslint 'src/**/*.{ts,tsx}' 'scripts/**/*.js'",
    "format": "prettier --write 'src/**/*.{ts,tsx}' 'scripts/**/*.js' '*.{json,js}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx}' 'scripts/**/*.js' '*.{json,js}'",
    "check:secrets": "node scripts/check-secrets.js",
    "test": "vitest run",
    "check:structure": "node scripts/check-structure.js",
    "check:order": "node scripts/check-order.js",
    "check:coverage": "node scripts/check-coverage.js",
    "check:sentence-coverage": "node scripts/check-sentence-coverage.js",
    "check:shape": "node scripts/check-shape.js",
    "check:grammar-distractors": "node scripts/check-grammar-distractors.js"
  },
  "dependencies": {
    "@expo-google-fonts/fraunces": "^0.2.3",
    "@expo-google-fonts/noto-nastaliq-urdu": "^0.2.3",
    "@expo-google-fonts/public-sans": "^0.2.3",
    "@expo/metro-runtime": "~4.0.1",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "@supabase/supabase-js": "2.45.4",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.1",
    "expo-auth-session": "~6.0.3",
    "expo-av": "~15.0.2",
    "expo-crypto": "~14.0.2",
    "expo-font": "~13.0.3",
    "expo-haptics": "~14.0.1",
    "expo-speech": "~13.0.1",
    "expo-splash-screen": "~0.29.21",
    "expo-status-bar": "~2.0.1",
    "expo-web-browser": "~14.0.2",
    "nativewind": "4.1.23",
    "react": "18.3.1",
    "react-dom": "^18.3.1",
    "react-native": "0.76.6",
    "react-native-css-interop": "0.1.22",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.19.13",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~18.3.12",
    "@types/react-test-renderer": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^4.6.2",
    "playwright": "1.49.0",
    "prettier": "^3.9.6",
    "react-test-renderer": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.3.3",
    "vitest": "^4.1.10"
  },
  "private": true
}
