diff --git a/scripts/check-offline.js b/scripts/check-offline.js
new file mode 100644
index 00000000..669eac74
--- /dev/null
+++ b/scripts/check-offline.js
@@ -0,0 +1,157 @@
+/* eslint-disable */
+/**
+ * An installed Qaaf opens with no signal (P-111, launch bar R6).
+ *
+ * The manifest makes the web app installable, and until the service worker
+ * existed the installed icon opened the browser's offline page: a promise
+ * broken on the train. This drives the built app in a real browser profile,
+ * lets the worker install, cuts the network, and asserts:
+ *
+ *   - the worker controls the page and holds every file it lists, within the
+ *     size budget;
+ *   - a lesson reloaded offline opens on its first card, with the Nastaliq
+ *     font drawn;
+ *   - the app opened offline from its start address reaches Home.
+ *
+ * Needs a web build in dist/ with web:meta run on it.
+ *
+ * Run with:  npm run check:offline
+ */
+
+const fs = require('fs');
+const os = require('os');
+const path = require('path');
+const { serveDist, findChromium, openTheDoor } = require('./lib/serve-dist');
+const { precacheSize, BUDGET_GZIP, BUDGET_RAW } = require('./lib/service-worker');
+
+const DIST = path.join(__dirname, '..', 'dist');
+const PORT = 8347;
+
+const html = fs.existsSync(path.join(DIST, 'index.html')) ? fs.readFileSync(path.join(DIST, 'index.html'), 'utf8') : '';
+const workerFile = path.join(DIST, 'sw.js');
+if (!html || !fs.existsSync(workerFile)) {
+  console.error('check:offline: no dist/index.html or dist/sw.js. Build the web app and run web:meta first.');
+  process.exit(1);
+}
+const BASE = (/<meta name="qaaf:base" content="([^"]*)"/.exec(html)?.[1] ?? '').replace(/\/+$/, '');
+const source = fs.readFileSync(workerFile, 'utf8');
+const VERSION = /const VERSION = "([^"]+)"/.exec(source)?.[1];
+const PRECACHE = JSON.parse(/const PRECACHE = (\[.*\]);/.exec(source)?.[1] ?? '[]');
+
+const problems = [];
+
+(async () => {
+  const { chromium } = require('playwright-core');
+  const server = await serveDist(DIST, PORT);
+  const profile = fs.mkdtempSync(path.join(os.tmpdir(), 'qaaf-offline-'));
+  const context = await chromium.launchPersistentContext(profile, {
+    executablePath: findChromium() || undefined,
+    viewport: { width: 390, height: 844 },
+  });
+  const root = `http://localhost:${PORT}${BASE}/`;
+  try {
+    const page = context.pages()[0] || (await context.newPage());
+    await page.goto(root);
+    await openTheDoor(page);
+    await page.evaluate(() => {
+      const raw = JSON.parse(localStorage.getItem('qaaf-progress') || '{"state":{},"version":0}');
+      raw.state = { ...raw.state, onboarded: true, goal: 'read', level: 0, hearts: 5, completedLessons: {} };
+      localStorage.setItem('qaaf-progress', JSON.stringify(raw));
+    });
+    await page.goto(root);
+
+    // The first visit installs the worker; the next opening of the start
+    // address is the one it serves, as an installed app's launch is. (Home's
+    // own address is the base without its slash, /Urdu, which the router
+    // writes after load and which lies outside the worker's scope /Urdu/, so
+    // reloading Home in a tab offline is the one case not covered.) Polled,
+    // with a limit, so a worker that never activates fails rather than hangs.
+    let active = false;
+    for (let i = 0; i < 80 && !active; i++) {
+      active = await page.evaluate(
+        async () =>
+          !!(await navigator.serviceWorker.getRegistrations()).find((r) => r.active && r.active.state === 'activated')
+      );
+      if (!active) await page.waitForTimeout(250);
+    }
+    if (!active) {
+      problems.push('no service worker installed (was web:meta run, and is it registered?)');
+      throw new Error('stop');
+    }
+    await page.goto(root);
+    const controlled = await page
+      .waitForFunction(() => !!navigator.serviceWorker && !!navigator.serviceWorker.controller, null, {
+        timeout: 20000,
+      })
+      .then(
+        () => true,
+        () => false
+      );
+    if (!controlled) {
+      problems.push('the worker installed but did not serve the start address');
+      throw new Error('stop');
+    }
+    const held = await page.evaluate(async (version) => {
+      const [reg] = await navigator.serviceWorker.getRegistrations();
+      const cache = (await caches.has(version)) ? await caches.open(version) : null;
+      return { scope: reg ? reg.scope : '', entries: cache ? (await cache.keys()).length : 0 };
+    }, VERSION);
+    if (!held.scope.endsWith(`${BASE}/`)) problems.push(`the worker's scope is ${held.scope}, not the app's ${BASE}/`);
+    if (held.entries !== PRECACHE.length)
+      problems.push(`the cache holds ${held.entries} of the ${PRECACHE.length} files the worker lists`);
+    const size = precacheSize(DIST, PRECACHE);
+    if (size.gzip > BUDGET_GZIP)
+      problems.push(`the precache is ${Math.round(size.gzip / 1024)} KB gzipped, over ${BUDGET_GZIP / 1024} KB`);
+    if (size.raw > BUDGET_RAW)
+      problems.push(`the precache is ${Math.round(size.raw / 1024)} KB raw, over ${BUDGET_RAW / 1024} KB`);
+
+    // A lesson reloaded with no signal.
+    await page.goto(`${root}lesson/l-1`);
+    await page.waitForFunction(() => /\d+ of \d+/.test(document.body.innerText), null, { timeout: 20000 });
+    await context.setOffline(true);
+    await page.reload().catch((e) => problems.push(`reloading l-1 offline failed: ${e.message.split('\n')[0]}`));
+    const lesson = await page
+      .waitForFunction(() => /a new letter/i.test(document.body.innerText), null, { timeout: 15000 })
+      .then(
+        () => true,
+        () => false
+      );
+    if (!lesson) problems.push('l-1 reloaded offline did not reach its first card');
+    else {
+      const nastaliq = await page.evaluate(async () => {
+        await document.fonts.ready;
+        return [...document.fonts].some((f) => /nastaliq/i.test(f.family) && f.status === 'loaded');
+      });
+      if (!nastaliq) problems.push('l-1 reloaded offline drew no Nastaliq font');
+    }
+
+    // The app opened offline from its start address.
+    const fresh = await context.newPage();
+    await fresh.goto(root).catch((e) => problems.push(`opening the app offline failed: ${e.message.split('\n')[0]}`));
+    const home = await fresh
+      .waitForFunction(() => /meet the letters|start here|continue/i.test(document.body.innerText), null, {
+        timeout: 15000,
+      })
+      .then(
+        () => true,
+        () => false
+      );
+    if (!home) problems.push('the app opened offline did not reach Home');
+  } catch (e) {
+    if (e.message !== 'stop') throw e;
+  } finally {
+    await context.close();
+    server.close();
+    fs.rmSync(profile, { recursive: true, force: true });
+  }
+
+  if (problems.length) {
+    console.error('check:offline failed:');
+    for (const p of problems) console.error(`  - ${p}`);
+    process.exit(1);
+  }
+  console.log(`check:offline: ${VERSION} holds ${PRECACHE.length} files; a lesson and Home open with no signal.`);
+})().catch((e) => {
+  console.error(e);
+  process.exit(1);
+});
