diff --git a/scripts/lib/service-worker.js b/scripts/lib/service-worker.js
new file mode 100644
index 00000000..39ca1329
--- /dev/null
+++ b/scripts/lib/service-worker.js
@@ -0,0 +1,176 @@
+/* eslint-disable */
+/**
+ * The service worker that lets an installed Qaaf open with no signal (P-111).
+ *
+ * Chrome offered to install the web app and the installed icon then showed
+ * the offline dinosaur, which is a promise broken on the train, the one place
+ * a phone app is most used (R6; design review, 2026-10-24 and 2026-10-28). The
+ * worker keeps what a first lesson needs, about 2.3 MB gzipped, and nothing
+ * else ahead of time.
+ *
+ * Written at export by inject-web-meta, never under `expo start`, so a dev
+ * server is never cached. Every URL is resolved against the worker's own
+ * scope, so nothing here names /Urdu.
+ *
+ * - Pages: network first, never stored by address; offline, the cached app
+ *   shell. Pages' own 404.html for deep links passes through untouched.
+ * - Hashed files (a 32-hex content hash in the name, after a dot for assets
+ *   and a hyphen for the JS and CSS bundles): cache first. Voice clips
+ *   go into `qaaf-audio` as they are played, at most 300, oldest out first.
+ * - Anything else, any other origin, any non-GET: the network, untouched.
+ * - Updates: the version is a hash of the precached files' bytes, so a deploy
+ *   that changes them changes sw.js; the new worker takes over at once and
+ *   deletes only this app's old `qaaf-` caches. Cache Storage is shared with
+ *   every repository on thamistco.github.io, so it never deletes all of them.
+ *
+ * If the worker ever misbehaves, removing its registration does not remove an
+ * installed copy: ship `scripts/sw-kill.js` as dist/sw.js instead.
+ */
+
+const fs = require('fs');
+const path = require('path');
+const crypto = require('crypto');
+const zlib = require('zlib');
+
+/** Most of the precache, gzipped and raw: the check holds the build to it. */
+const BUDGET_GZIP = 2.5 * 1024 * 1024;
+const BUDGET_RAW = 6 * 1024 * 1024;
+const AUDIO_CAP = 300;
+
+const SOUNDS = ['correct', 'incorrect', 'levelup', 'streak', 'tap'];
+const SCENERY = ['evening', 'evening-dusk'];
+const HASHED = '\\.[0-9a-f]{32}\\.[a-z0-9]+$';
+
+function filesUnder(dir) {
+  const out = [];
+  for (const e of fs.readdirSync(dir, { withFileTypes: true })) {
+    const f = path.join(dir, e.name);
+    if (e.isDirectory()) out.push(...filesUnder(f));
+    else out.push(f);
+  }
+  return out;
+}
+
+/**
+ * Every file the app shell needs, relative to the site root, each named from
+ * the build rather than matched by a pattern at run time. `cache.addAll` is
+ * all or nothing, so a name that 404s fails the install and keeps the old
+ * worker; one missing here fails the export instead.
+ */
+function precacheList(dist, html, baseUrl) {
+  const prefix = `${baseUrl}/`;
+  const fromPage = [...html.matchAll(/(?:href|src)="([^"]+\.(?:css|js|ttf))"/g)]
+    .map((m) => m[1])
+    .filter((href) => href.startsWith(prefix))
+    .map((href) => href.slice(prefix.length));
+  const assets = filesUnder(path.join(dist, 'assets')).map((f) => path.relative(dist, f).split(path.sep).join('/'));
+  const named = (base) => {
+    const hit = assets.find((a) => new RegExp(`/${base}${HASHED}`).test(a));
+    if (!hit) throw new Error(`service worker: no ${base}.<hash> in the export`);
+    return hit;
+  };
+  const list = [
+    './',
+    'manifest.webmanifest',
+    'app-icon.png',
+    'favicon.ico',
+    ...fromPage,
+    named('NotoNastaliqUrdu_700Bold'),
+    ...SOUNDS.map(named),
+    ...SCENERY.map(named),
+  ];
+  const unique = [...new Set(list)];
+  for (const entry of unique) {
+    const file = path.join(dist, entry === './' ? 'index.html' : decodeURI(entry));
+    if (!fs.existsSync(file)) throw new Error(`service worker: ${entry} is not in the export`);
+  }
+  return unique;
+}
+
+/** The bytes the worker will hold, raw and gzipped, for the budget. */
+function precacheSize(dist, list) {
+  let raw = 0;
+  let gzip = 0;
+  for (const entry of list) {
+    const buf = fs.readFileSync(path.join(dist, entry === './' ? 'index.html' : decodeURI(entry)));
+    raw += buf.length;
+    gzip += zlib.gzipSync(buf).length;
+  }
+  return { raw, gzip };
+}
+
+function workerSource(version, list) {
+  return `// Written by scripts/lib/service-worker.js at export (P-111). Do not edit.
+const VERSION = ${JSON.stringify(version)};
+const AUDIO = 'qaaf-audio';
+const PRECACHE = ${JSON.stringify(list)};
+// Expo names assets name.<hash>.ext and its bundles name-<hash>.js|css.
+const HASHED = /[.-][0-9a-f]{32}\\.[a-z0-9]+$/;
+const SCOPE = self.registration.scope;
+
+self.addEventListener('install', (e) => {
+  e.waitUntil(
+    caches.open(VERSION)
+      .then((c) => c.addAll(PRECACHE.map((u) => new URL(u, SCOPE).href)))
+      .then(() => self.skipWaiting())
+  );
+});
+
+self.addEventListener('activate', (e) => {
+  e.waitUntil(
+    caches.keys()
+      .then((keys) => Promise.all(keys.filter((k) => k.startsWith('qaaf-') && k !== VERSION && k !== AUDIO).map((k) => caches.delete(k))))
+      .then(() => self.clients.claim())
+  );
+});
+
+async function keepAudio(url, response) {
+  const cache = await caches.open(AUDIO);
+  await cache.put(url, response);
+  const keys = await cache.keys();
+  for (const old of keys.slice(0, Math.max(0, keys.length - ${AUDIO_CAP}))) await cache.delete(old);
+}
+
+self.addEventListener('fetch', (e) => {
+  const req = e.request;
+  const url = new URL(req.url);
+  if (req.method !== 'GET' || !url.href.startsWith(SCOPE)) return;
+  if (req.mode === 'navigate') {
+    e.respondWith(fetch(req).catch(() => caches.match(SCOPE, { cacheName: VERSION })));
+    return;
+  }
+  if (!HASHED.test(url.pathname)) return;
+  e.respondWith(
+    caches.match(url.href, { ignoreSearch: true }).then(
+      (hit) =>
+        hit ||
+        fetch(url.href).then((r) => {
+          if (r.status === 200 && /\\.(mp3|m4a|ogg|wav)$/.test(url.pathname)) e.waitUntil(keepAudio(url.href, r.clone()));
+          return r;
+        })
+    )
+  );
+});
+`;
+}
+
+/**
+ * Write dist/sw.js and return the tag that registers it. The path is absolute
+ * under the base: a relative one would resolve against /Urdu/lesson/l-1 on a
+ * deep link and register nothing.
+ */
+function writeServiceWorker(dist, html, baseUrl) {
+  const list = precacheList(dist, html, baseUrl);
+  const hash = crypto.createHash('sha256');
+  for (const entry of list) {
+    if (entry !== './') hash.update(fs.readFileSync(path.join(dist, decodeURI(entry))));
+  }
+  const version = `qaaf-${hash.digest('hex').slice(0, 8)}`;
+  fs.writeFileSync(path.join(dist, 'sw.js'), workerSource(version, list));
+  const tag =
+    `<script>if ('serviceWorker' in navigator) addEventListener('load', function () {` +
+    ` navigator.serviceWorker.register('${baseUrl}/sw.js', { scope: '${baseUrl}/' }); });</script>`;
+  return { tag, version, list, size: precacheSize(dist, list) };
+}
+
+module.exports = { writeServiceWorker, precacheList, precacheSize, BUDGET_GZIP, BUDGET_RAW };
diff --git a/scripts/sw-kill.js b/scripts/sw-kill.js
new file mode 100644
index 00000000..987fc075
--- /dev/null
+++ b/scripts/sw-kill.js
@@ -0,0 +1,23 @@
+/* eslint-disable */
+// The service worker's off switch (P-111). Not shipped normally.
+//
+// Removing the registration from the page does not remove a worker a learner
+// already has: it keeps serving from its cache until something replaces it.
+// If the real worker ever misbehaves, copy this file over dist/sw.js in the
+// deploy instead. Browsers check sw.js for changes on each visit, so this one
+// installs, deletes this app's caches (only the `qaaf-` ones: Cache Storage is
+// shared with every repository on the same host), unregisters itself and
+// reloads any open page onto the network. Learners' progress is in
+// localStorage, not in a cache, and is not touched.
+self.addEventListener('install', () => self.skipWaiting());
+self.addEventListener('activate', (e) => {
+  e.waitUntil(
+    (async () => {
+      const keys = await caches.keys();
+      await Promise.all(keys.filter((k) => k.startsWith('qaaf-')).map((k) => caches.delete(k)));
+      await self.registration.unregister();
+      const pages = await self.clients.matchAll({ type: 'window' });
+      for (const page of pages) page.navigate(page.url);
+    })()
+  );
+});
