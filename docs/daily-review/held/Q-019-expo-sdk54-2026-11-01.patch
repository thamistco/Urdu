From 8724f5e91cd7fc13c506ee67fc5d64e9f3246886 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 1 Nov 2026 01:28:21 +0000
Subject: [PATCH] Pin expo with a tilde, as expo install writes every other
 Expo module

"^54.0.0" could not drift past 54 (the lockfile holds 54.0.38), but it
was the one Expo pin in a different style (second check and audit,
2026-11-01). Mechanical: no installed version changes.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01FgFsmHsJ32w9Di1MVKqKTX
---
 package-lock.json | 2 +-
 package.json      | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/package-lock.json b/package-lock.json
index fc9863e2..055d9cc0 100644
--- a/package-lock.json
+++ b/package-lock.json
@@ -17,7 +17,7 @@
         "@react-navigation/native": "^7.0.14",
         "@react-navigation/native-stack": "^7.2.0",
         "@supabase/supabase-js": "2.45.4",
-        "expo": "^54.0.0",
+        "expo": "~54.0.38",
         "expo-asset": "~12.0.14",
         "expo-auth-session": "~7.0.11",
         "expo-av": "~16.0.8",
diff --git a/package.json b/package.json
index b0b29cd9..d574cfcb 100644
--- a/package.json
+++ b/package.json
@@ -77,7 +77,7 @@
