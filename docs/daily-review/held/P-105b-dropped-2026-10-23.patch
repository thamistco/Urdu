+/**
+ * The forms of a letter its own lesson never asks by recognition, by glyph, so
+ * a non-joiner's identical forms are one form, not two.
+ *
+ * A letter lesson asks some forms only by tracing: Unit 2's l-2 never asks se
+ * medial or final, jeem isolated or final, che initial, baRi-he initial or
+ * final, or khe isolated by picking or naming them, and seven review sittings
+ * still left four of those never recognised, since review picks a form by
+ * index and never looks at what the lesson asked. 33 letters in all nine
+ * letter lessons have such a form (learning review, 2026-10-23, P-105b).
+ *
+ * Built once, from the letter lessons themselves with no review items, so it
+ * follows them if they change. Letter lessons are the same on every build.
+ */
+let recogniseGapCache: Map<string, PositionKey[]> | null = null;
+export function recogniseGaps(letterId: string): PositionKey[] {
+  if (!recogniseGapCache) {
+    const recognised = new Map<string, Set<string>>();
+    for (const lesson of ALL_LESSONS.filter((l) => l.kind === 'letters')) {
+      for (const ex of buildLessonExercises(lesson, [], 'both', new Set())) {
+        if (ex.kind !== 'letterForm' && ex.kind !== 'letterPick') continue;
+        const seen = recognised.get(ex.letter.id) ?? new Set<string>();
+        seen.add(ex.letter.forms[ex.position]);
+        recognised.set(ex.letter.id, seen);
+      }
+    }
+    recogniseGapCache = new Map();
+    for (const l of LETTERS) {
+      const seen = recognised.get(l.id) ?? new Set<string>();
+      const glyphs = new Set<string>();
+      const gaps: PositionKey[] = [];
+      for (const { key } of POSITIONS) {
+        const glyph = l.forms[key as PositionKey];
+        if (seen.has(glyph) || glyphs.has(glyph)) continue;
+        glyphs.add(glyph);
+        gaps.push(key as PositionKey);
+      }
+      recogniseGapCache.set(l.id, gaps);
+    }
+  }
+  return recogniseGapCache.get(letterId) ?? [];
+}
+
+/**
+ * A letter in review: on two turns in three, recognition on a form its lesson
+ * only traced, while it has one; on the third, and for a letter with none,
+ * `letterExerciseAt` as before, tracing included (P-105b). Taking tracing out
+ * entirely left naming or picking on every turn, and a review with only
+ * letters due went to 52% "which position", past check:shape's 40%; tracing
+ * also helps letters be recognised (Longcamp et al. 2005).
+ */
+function reviewLetterExercise(letter: Letter, turn: number, positionIndex: number): Exercise {
+  const gaps = recogniseGaps(letter.id);
+  const t = ((turn % 3) + 3) % 3;
+  if (!gaps.length || t === 0) return letterExerciseAt(letter, turn, positionIndex);
+  const position = gaps[((positionIndex % gaps.length) + gaps.length) % gaps.length];
+  if (t === 2) {
+    const distractors = distractLetters(letter, DISTRACTORS, position);
+    return { kind: 'letterPick', letter, position, options: shuffle([letter, ...distractors]) };
+  }
+  return { kind: 'letterForm', letter, position, options: POSITIONS.map((p) => p.key) };
+}
